    { "op": "create_user_defined_struct", "uds_path": "/Game/_M28_test/Structs/S_EnemyArchetype" },

    { "op": "add_uds_member", "uds_path": "/Game/_M28_test/Structs/S_EnemyArchetype", "member_name": "AggressionScore", "var_type_spec": "real", "default_value": "0.5"    },
    { "op": "add_uds_member", "uds_path": "/Game/_M28_test/Structs/S_EnemyArchetype", "member_name": "CoverPreference", "var_type_spec": "real", "default_value": "0.5"    },
    { "op": "add_uds_member", "uds_path": "/Game/_M28_test/Structs/S_EnemyArchetype", "member_name": "Mobility",        "var_type_spec": "real", "default_value": "1.0"    },
    { "op": "add_uds_member", "uds_path": "/Game/_M28_test/Structs/S_EnemyArchetype", "member_name": "Accuracy",        "var_type_spec": "real", "default_value": "0.7"    },
    { "op": "add_uds_member", "uds_path": "/Game/_M28_test/Structs/S_EnemyArchetype", "member_name": "SightRadius",     "var_type_spec": "real", "default_value": "1500.0" },
    { "op": "add_uds_member", "uds_path": "/Game/_M28_test/Structs/S_EnemyArchetype", "member_name": "FireRate",        "var_type_spec": "real", "default_value": "1.0"    },

    { "op": "remove_uds_member", "uds_path": "/Game/_M28_test/Structs/S_EnemyArchetype", "member_name": "BpxAutoBool" },

    { "op": "create_curve_float", "curve_path": "/Game/_M28_test/Curves/Curve_Rusher_AggressionVsDistance"     },
