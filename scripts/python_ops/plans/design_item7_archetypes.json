    { "op": "create_curve_float", "curve_path": "/Game/_M28_test/Curves/Curve_Flanker_AggressionVsDistance"    },

    { "op": "set_curve_float_keys", "curve_path": "/Game/_M28_test/Curves/Curve_Rusher_AggressionVsDistance",
      "keys": [
        { "time": 0.0,    "value": 1.0 },
        { "time": 500.0,  "value": 0.9 },
        { "time": 1500.0, "value": 0.4 },
        { "time": 3000.0, "value": 0.1 }
      ]
    },
    { "op": "set_curve_float_keys", "curve_path": "/Game/_M28_test/Curves/Curve_Marksman_AggressionVsDistance",
      "keys": [
        { "time": 0.0,    "value": 0.2 },
        { "time": 500.0,  "value": 0.4 },
        { "time": 2000.0, "value": 0.9 },
        { "time": 4000.0, "value": 1.0 }
      ]
    },
    { "op": "set_curve_float_keys", "curve_path": "/Game/_M28_test/Curves/Curve_Suppresser_AggressionVsDistance",
      "keys": [
        { "time": 0.0,    "value": 0.85 },
        { "time": 1500.0, "value": 0.85 },
        { "time": 3000.0, "value": 0.85 }
